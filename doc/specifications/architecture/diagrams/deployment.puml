@startuml deployment
' See ../deployment-architecture.md and ../../23-deployment.md
title ClipFactory — Deployment (owner's Windows machine, WSL2, native)

actor "Owner browser (Windows)" as browser
cloud "Instagram / Facebook servers" as ig

node "Windows host" {
  component "Owner reverse proxy\n(forwards /public/media/* only)" as proxy
  node "WSL2 (Ubuntu)" {
    component "clipfactory serve\n(FastAPI + SPA + workflow + scheduler)\n1 process, 1 worker" as svc
    component "FFmpeg / FFprobe" as ffmpeg
    component "faster-whisper / wan_local\n(CUDA via WSL2)" as models
    component "ComfyUI (optional, local HTTP)" as comfy
    database "PostgreSQL 16 (native)" as pg
    folder "Data directory (ext4)\nassets / clips / work / cache / secrets" as data
  }
}

cloud "External providers\n(LLM, TTS, media, news, Higgsfield, platforms)" as ext

browser --> svc : http://localhost:8000
ig --> proxy : HTTPS signed media URL
proxy --> svc : /public/media/{token}
svc --> pg
svc --> ffmpeg : subprocess
svc --> models : thread
svc --> comfy : HTTP
svc --> data : read/write
svc --> ext : outbound HTTPS
@enduml
