# ClipFactory environment template.
# Copy to .env and fill in real values. Never commit .env.
# Keys and defaults: doc/specifications/18-configuration.md
# Setup guide:       doc/setup/platform-credentials.md

# --- Deployment ---
APP_ENV=development
DATABASE_URL=postgresql+psycopg://clipfactory:clipfactory-local@localhost:5432/clipfactory
DRAGONFLY_URL=redis://127.0.0.1:6380/0
DATA_DIR=/home/YOUR_USER/clipfactory-data
HOST=127.0.0.1
PORT=8000
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Required only when HOST is not loopback (>= 32 random characters)
API_TOKEN=
LOG_LEVEL=INFO
SCHEDULER_ENABLED=true

# --- Provider selection (use "fake" for offline development) ---
LLM_PROVIDER=openai_compatible
NEWS_SOURCES=rss
MEDIA_SOURCES=pexels,pixabay,unsplash,wikimedia_commons
IMAGE_PROVIDERS=comfyui,higgsfield
VIDEO_PROVIDERS=comfyui,wan_local,higgsfield
TTS_PROVIDER=google
TRANSCRIPTION_PROVIDER=whisper_local
PUBLISHERS=youtube,instagram,tiktok,facebook
STORAGE_PROVIDER=local

# --- LLM (OpenRouter, OpenAI-compatible) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemma-4-31b-it:free
LLM_MODEL_EVALUATION=google/gemma-4-31b-it:free
LLM_REQUEST_TIMEOUT_SECONDS=120

# --- TTS (Google Cloud Text-to-Speech, Chirp 3 HD) ---
GOOGLE_APPLICATION_CREDENTIALS=/home/YOUR_USER/.config/clipfactory/google-tts.json

# --- Transcription (faster-whisper) ---
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=default

# --- Media sources ---
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
WIKIMEDIA_USER_AGENT="ClipFactory/1.0 (contact: you@example.com)"

# --- Generation ---
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOWS_DIR=/home/YOUR_USER/clipfactory-data/comfyui-workflows
# --- Typed local graphics renderers ---
NODE_PATH=node
HYPERFRAMES_PACKAGE_DIR=/home/YOUR_USER/ClipFactory/backend/renderers/hyperframes
HYPERFRAMES_PATH=/home/YOUR_USER/ClipFactory/backend/renderers/hyperframes/clipfactory-hyperframes.mjs
MANIM_PATH=/home/YOUR_USER/ClipFactory/.venv/bin/manim
GRAPHICS_FPS=30
GRAPHICS_TIMEOUT_SECONDS=180
# HyperFrames package release is pinned exactly in its local package lock; do not use an unpinned global install.
WAN_MODEL=Wan-AI/Wan2.1-T2V-1.3B-Diffusers
WAN_DEVICE=cuda
WAN_FPS=16
WAN_INFERENCE_STEPS=25
WAN_MAX_GENERATIONS_PER_RUN=2
WAN_MODEL_LICENSE=Apache-2.0
HIGGSFIELD_API_KEY=

# --- Publishing ---
YOUTUBE_CLIENT_SECRETS_FILE=/home/YOUR_USER/.config/clipfactory/youtube-client.json
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
# Signed public media URLs for Instagram/Facebook (reverse proxy forwards only /public/media/*)
PUBLIC_MEDIA_DIR=/home/YOUR_USER/clipfactory-public
PUBLIC_MEDIA_BASE_URL=
MEDIA_URL_SIGNING_KEY=

# --- Tests ---
# Set to 1 to run opt-in live provider tests
LIVE_TESTS=
