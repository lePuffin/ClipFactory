# OpenRouter exposes an OpenAI-compatible API. Do not commit the populated .env file.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
# Retry temporary 429s (including free-model shared-pool limits) without changing models.
LLM_RATE_LIMIT_RETRIES=3
LLM_RATE_LIMIT_MAX_WAIT_SECONDS=60
# Maximum completion budget for compact structured reel scripts and repairs.
LLM_SCRIPT_MAX_TOKENS=8000

# faster-whisper settings. Use cpu on machines without a supported CUDA runtime.
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=default

OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
OUTPUT_DIR=./output
TEMP_DIR=./temp
DOWNLOAD_DIR=./downloads
DATA_DIR=./data
MAX_UPLOAD_SIZE_BYTES=21474836480

# The narration model chooses the final clip duration within this safe range.
CLIP_MIN_DURATION_SECONDS=30
CLIP_MAX_DURATION_SECONDS=300

# v0.5 reels use these targets before measured spoken timing extends individual scenes.
REEL_MIN_DURATION_SECONDS=20
REEL_MAX_DURATION_SECONDS=60
REEL_WORDS_PER_MINUTE=155

# Explicit v0.4 editorial ranking weights. At least one must be positive.
EDITORIAL_IMPORTANCE_WEIGHT=0.17
EDITORIAL_NOVELTY_WEIGHT=0.12
EDITORIAL_AUDIENCE_INTEREST_WEIGHT=0.16
EDITORIAL_CLARITY_WEIGHT=0.12
EDITORIAL_STORYTELLING_POTENTIAL_WEIGHT=0.14
EDITORIAL_FACTUAL_SUPPORT_WEIGHT=0.14
EDITORIAL_VISUAL_POTENTIAL_WEIGHT=0.08
EDITORIAL_SOURCE_COVERAGE_WEIGHT=0.07

# v0.5 AI narration. TTS_BACKEND remains a compatible alias for TTS_PROVIDER.
TTS_ENABLED=true
TTS_PROVIDER=chatterbox
TTS_MODEL=turbo
TTS_VOICE=
TTS_LANGUAGE=en
TTS_SPEED=1.0
TTS_RATE=175
TTS_SENTENCE_PAUSE_SECONDS=0.15
TTS_TIMING_POLICY=extend_scene
TTS_CACHE_ENABLED=true
TTS_AUDIO_SAMPLE_RATE=48000
TTS_NARRATION_VOLUME=0.9
TTS_SOURCE_AUDIO_ENABLED=true
TTS_SOURCE_AUDIO_VOLUME=0.12
TTS_DUCKING_ENABLED=true
TTS_FALLBACK_ENABLED=false
# Force TTS to use CPU if experiencing CUDA compatibility issues (e.g., with newer GPUs)
TTS_FORCE_CPU=false

# Dynamic local smart framing. Set SMART_CROP_DEBUG=true to retain per-clip decisions.
SMART_CROP_ENABLED=true
SMART_CROP_DETECTION_INTERVAL_SECONDS=0.5
SMART_CROP_DETECTION_CONFIDENCE_THRESHOLD=0.5
SMART_CROP_TRACKING_CONFIDENCE_THRESHOLD=0.5
SMART_CROP_SMOOTHING_STRENGTH=0.35
SMART_CROP_DEAD_ZONE_PIXELS=32
SMART_CROP_MAX_CAMERA_SPEED_PIXELS_PER_SECOND=480
SMART_CROP_SCENE_CHANGE_THRESHOLD=0.35
SMART_CROP_TRACKING_GRACE_SECONDS=1.5
SMART_CROP_DEBUG=false