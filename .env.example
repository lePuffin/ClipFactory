# OpenRouter exposes an OpenAI-compatible API. Do not commit the populated .env file.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

# faster-whisper settings. Use cpu on machines without a supported CUDA runtime.
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=default

OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
OUTPUT_DIR=./output
TEMP_DIR=./temp
DOWNLOAD_DIR=./downloads
DATA_DIR=./data
MAX_UPLOAD_SIZE_BYTES=21474836480

# The narration model chooses the final reel duration within this safe range.
REEL_MIN_DURATION_SECONDS=30
REEL_MAX_DURATION_SECONDS=300

# Chatterbox Turbo is the default English narration backend for local reels.
TTS_BACKEND=chatterbox
TTS_MODEL=turbo
TTS_LANGUAGE=en
# Force TTS to use CPU if experiencing CUDA compatibility issues (e.g., with newer GPUs)
TTS_FORCE_CPU=false

# Dynamic local smart framing. Set SMART_CROP_DEBUG=true to retain per-clip decisions.
SMART_CROP_ENABLED=true
SMART_CROP_DETECTION_INTERVAL_SECONDS=0.5
SMART_CROP_DETECTION_CONFIDENCE_THRESHOLD=0.5
SMART_CROP_TRACKING_CONFIDENCE_THRESHOLD=0.5
SMART_CROP_SMOOTHING_STRENGTH=0.35
SMART_CROP_DEAD_ZONE_PIXELS=32
SMART_CROP_MAX_CAMERA_SPEED_PIXELS_PER_SECOND=480
SMART_CROP_SCENE_CHANGE_THRESHOLD=0.35
SMART_CROP_TRACKING_GRACE_SECONDS=1.5
SMART_CROP_DEBUG=false