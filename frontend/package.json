{
    "name": "clipfactory-frontend",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "typecheck": "tsc -b --pretty",
        "test": "vitest run",
        "test:watch": "vitest",
        "generate:api": "openapi-typescript ../backend/openapi.json -o src/api/schema.ts"
    },
    "dependencies": {
        "@tanstack/react-query": "^5.90.0",
        "lucide-react": "^0.468.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-router-dom": "^7.9.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.0",
        "@testing-library/jest-dom": "^6.9.0",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^22.19.0",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^5.0.0",
        "autoprefixer": "^10.4.22",
        "eslint": "^9.39.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.24",
        "globals": "^16.5.0",
        "jsdom": "^27.0.0",
        "openapi-typescript": "^7.10.0",
        "postcss": "^8.5.6",
        "tailwindcss": "^3.4.18",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.46.0",
        "vite": "^7.1.12",
        "vitest": "^3.2.4"
